{
    "name": "deliveryapp-react",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "preview": "vite preview --host 127.0.0.1",
        "test": "node scripts/build-tests.mjs && karma start karma.conf.cjs --single-run",
        "test:watch": "node scripts/build-tests.mjs && karma start karma.conf.cjs --no-single-run",
        "format": "prettier --write src tests scripts *.js *.cjs *.json *.html docs/*.md README.md"
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.9.0",
        "bootstrap": "^5.3.2"
    },
    "devDependencies": {
        "vite": "^7.1.0",
        "@vitejs/plugin-react": "^5.0.0",
        "esbuild": "^0.25.0",
        "jasmine-core": "^5.9.0",
        "karma": "^6.4.4",
        "karma-jasmine": "^5.1.0",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "istanbul-lib-instrument": "^6.0.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/dom": "^10.4.1",
        "prettier": "^3.6.0"
    }
}
